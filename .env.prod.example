# Pre-scaffold production-env reference. This is only a hint for BEFORE `./app` exists.
#
# >>> Once you have an app, `forge productionize --app <APP> --host <DOMAIN>` GENERATES the
#     authoritative production stack UNDER app/:
#       - app/compose.prod.yaml   (prod compose project `forge-<APP>-prod`; DB-aware data-plane
#                                  sidecar + FORGE_DB_URL + Traefik Host(<DOMAIN>); image pins)
#       - app/.env.prod.example   (annotated: each secret · which capability · required/optional ·
#                                  how to obtain · a generate command)
#       - app/PROVISIONING.md     (the per-app operator runbook — the source of truth)
#     Copy app/.env.prod.example -> app/.env.prod and fill THAT (`forge release`/`forge deploy`
#     load app/.env.prod by default). Image digests are pinned by productionize/release — you do
#     not hand-edit pins here. See DEPLOY.md.

# --- identity (drive the prod compose project name, Traefik router/host, and DB name) ---
APP_NAME=myapp                     # slug: prod compose project `forge-<APP>-prod` + Traefik router
APP_HOST=myapp.example.com         # the public hostname Traefik routes to this app
DB_NAME=myapp                      # Postgres database name (if the app has its own DB)

# --- secrets (the deploy toolchain's stable set; the generated app/.env.prod.example lists yours) ---
# Master key for the platform/data-plane encrypted secret store — strong + STABLE
# (changing it makes stored secrets unreadable). Generate: openssl rand -hex 32
FORGE_SECRETS_KEY=change-me-in-prod
# Password for the separate `forge_platform` Postgres DB owned by --platform-store=postgres.
FORGE_PLATFORM_DB_PASSWORD=change-me-in-prod
# Session-signing secret for sign-in (C10) AND server-side sessions (C23). Keep it STABLE
# across deploys (rotating it invalidates live sessions). Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=change-me-in-prod
# Only if the app was provisioned `--with-postgres` (its own application DB).
POSTGRES_PASSWORD=change-me-in-prod
# Optional sign-in providers — configure ONE (or leave sign-in off). See app/PROVISIONING.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_URL=
