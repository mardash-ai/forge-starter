# Production env for `compose.prod.yaml`. Copy to `app/.env.prod` and set these — a plain
# `forge deploy` loads it (its `--env-file` defaults to `app/.env.prod`), so you should not need to
# edit compose.prod.yaml. Pin images by digest for reproducible prod (R1); `:latest` is convenience
# only. `app/.env.prod` is gitignored.

# --- identity (drive the compose project name, Traefik router/host, and DB name) ---
APP_NAME=myapp                     # slug: Traefik router/service name + data-plane app name
APP_HOST=myapp.example.com         # the public hostname Traefik routes to this app
DB_NAME=myapp                      # Postgres database name (letters/digits/underscore)

# --- images (pin by digest; `forge productionize` regenerates this file with these already pinned;
#     find one yourself with: docker buildx imagetools inspect <image>:<tag>) ---
# Your app's published production image — pass it to `forge productionize --web-image <ref@sha256:…>`.
APP_IMAGE=ghcr.io/your-org/your-app:latest
# Forge data-plane sidecar (scheduler + secrets) — pinned by digest.
FORGE_DATA_PLANE_IMAGE=ghcr.io/mardash-ai/forge-data-plane:0.15.1@sha256:804f5c4747844a6500a35461afd9e39ae2b0755675e4cdabfa5e0582348639fe
# Control-plane image — `make deploy` starts it transiently to run `forge deploy` (C7).
FORGE_IMAGE=ghcr.io/mardash-ai/forge-control-plane:0.15.1@sha256:925ffd0981b7de0253c73615781a67ee68ba462e7206d30d381947ea034502d1

# --- secrets ---
# Postgres: set POSTGRES_PASSWORD ONLY — the app's DATABASE_URL is derived from it in
# compose.prod.yaml, so the two can never drift (do NOT also set DATABASE_URL here).
POSTGRES_PASSWORD=change-me
# Empty ANTHROPIC_API_KEY degrades gracefully (AI features return 503; the app stays up).
ANTHROPIC_API_KEY=
# Master key for the data-plane's encrypted secret store — strong + STABLE (changing it makes
# stored secrets unreadable). Only needed if you run the data-plane sidecar.
FORGE_SECRETS_KEY=change-me-in-prod
