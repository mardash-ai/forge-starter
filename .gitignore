# Forge platform state (Resources, Events, logs) — regenerable, local.
.forge/

# App build artifacts, dependencies, and local env (single-app layout: the app is ./app).
app/node_modules/
app/.next/
app/next-env.d.ts
app/.env
# Production secrets live in app/.env.prod (loaded by `forge release`/`forge deploy`); never commit it.
# (app/.env.prod.example is the generated, tracked template — it does not match this pattern.)
app/.env.prod

# Local control-plane overrides (e.g. FORGE_SECRETS_KEY, GITHUB_TOKEN). Never commit it.
.env
*.log

# Operator-local deploy transport (e.g. SSH wrappers that may hold a key passphrase).
# Keep these OUT of the repo — see DEPLOY.md → "Deploying to a remote host".
/release/

# Starter model diff outputs — generated at release time by the release workflow.
# Not committed; attached as assets to the GitHub Release instead.
starter-changes.json
starter-changes.md

# Prettier-formatted temporary test scratch dir
.tmp-test-diff/
