# Copy to .env — docker compose auto-loads it to interpolate compose.yaml.
#
# FORGE_SECRETS_KEY is REQUIRED: the control plane refuses to start without it
# (compose.yaml declares `${FORGE_SECRETS_KEY:?…}`). Use a strong, stable value —
# it protects the platform secret store. Generate one with:
#   openssl rand -hex 32
FORGE_SECRETS_KEY=change-me-in-dev

# Optional: a GitHub token for private repo/registry access from Capabilities.
# GITHUB_TOKEN=ghp_...
