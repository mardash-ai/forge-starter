# Copy to .env to override defaults (optional).

# Which Forge control-plane image to run (the plane that ships `forge productionize` / `forge
# deploy`). Pin by digest — no `:latest` — so the dev platform is reproducible.
# FORGE_IMAGE=ghcr.io/mardash-ai/forge-control-plane:0.11.0@sha256:50fa8aded311077cc2a4af6a2edd65bb15877564e3d50a71393658eca3ca74bc

# Host/container port for the Forge API. Change this if you run more than one
# Forge project on the same machine at the same time (one platform per port).
# FORGE_PORT=3717
